{
  "name": "jevloop",
  "version": "0.1.0",
  "description": "A runnable harness for agent loops: the judgements go to a decision model, the LLM only writes. No dependencies, runs offline, no API key.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "demo": "node --experimental-strip-types examples/demo.ts",
    "serve": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "check": "node --experimental-strip-types scripts/check.ts",
    "conformance": "node --experimental-strip-types scripts/conformance.ts",
    "external-host": "node --experimental-strip-types examples/external-host.ts",
    "adapter-test": "node --experimental-strip-types --test tests/adapter.test.ts",
    "adapter-report": "node --experimental-strip-types scripts/adapter-report.ts",
    "bench": "node --experimental-strip-types bench/run.ts",
    "compare": "node --experimental-strip-types bench/compare.ts",
    "latency": "node --experimental-strip-types bench/latency.ts",
    "gate-compare": "node --experimental-strip-types bench/gate-compare.ts",
    "gate-derivable": "node --experimental-strip-types bench/gate-derivable-run.ts",
    "replay": "node --experimental-strip-types scripts/replay.ts",
    "trace": "node --experimental-strip-types scripts/trace.ts",
    "metrics": "node --experimental-strip-types scripts/metrics.ts",
    "claim-audit": "node --experimental-strip-types scripts/claim-audit.ts"
  },
  "keywords": [
    "agent",
    "jev",
    "decision-model",
    "system-one",
    "agent-framework",
    "llm"
  ],
  "devDependencies": {
    "typescript": "5.7.2",
    "@types/node": "^22.0.0"
  },
  "bin": {
    "jevloop": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "src",
    "web",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE",
    "DECISION.md",
    "docs/DECISION-CONTRACT.md",
    "docs/SKILL-DECISION-ADAPTER.md",
    "docs/RESEARCH-AND-STANDARD-DIRECTION-2026-09.md",
    "docs/ADAPTER-CODEX-SCOPE.md",
    "docs/POSITIONING-spec-vs-hook.md",
    "docs/MEASUREMENT-gate-equivalence.md",
    "adapters"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjunlp/JevLoop.git"
  },
  "homepage": "https://github.com/zjunlp/JevLoop",
  "bugs": {
    "url": "https://github.com/zjunlp/JevLoop/issues"
  }
}
