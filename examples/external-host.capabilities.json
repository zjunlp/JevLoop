{
  "adapter": "examples/external-host.ts",
  "contractSchema": "decision-contract/v1",
  "level": 2,
  "description": "Reference fixture: local decision execution plus a host-owned multi-node graph.",
  "positions": {
    "step-start": ["use_tool", "answer"],
    "tool-choice": ["call"],
    "input-choice": ["use"],
    "before-call": ["auto", "auto_audit", "ask_human"],
    "after-tool": ["continue", "stop", "finish", "keep_going"],
    "after-generate": ["deliver", "revise"]
  },
  "hostPositions": {
    "host:issue-triage": ["call"],
    "host:test-failure": ["call"],
    "host:review": ["ask_human", "finish"]
  },
  "customGraphNodes": [
    "classify_issue",
    "inspect_repository",
    "plan_patch",
    "run_tests",
    "interpret_failure",
    "prepare_candidate",
    "request_review"
  ],
  "terminalStates": ["done"],
  "graphFeatures": ["branch", "retry", "escalation", "terminal-state"],
  "projections": [
    "earlierMaybe",
    "describeDone",
    "filesMaybe",
    "readMaybe",
    "lastOrNone",
    "toolOrEmpty",
    "lastInput",
    "toolOrUnknown",
    "localToolRisk",
    "resultMaybe",
    "readCount",
    "recentSteps",
    "draftMaybe",
    "writeEvidence"
  ],
  "dynamicProviders": ["toolsFor", "fileOptions"],
  "dynamicProviderReads": {
    "toolsFor": ["history", "files", "readFiles", "canWrite", "canDelete"],
    "fileOptions": ["files", "readFiles"]
  },
  "conformance": {
    "command": "npm run external-host",
    "negativeFixtures": "tests/adapter.test.ts",
    "reportCheck": "npm run adapter-report",
    "dispatchAfterCapabilityCheck": true
  },
  "knownLimitations": [
    "The fixture uses a deterministic mock provider.",
    "Projection and dynamic-provider names are host-owned capabilities.",
    "The graph is a demonstration, not a universal graph runtime.",
    "Replay and event export are not yet implemented by this fixture.",
    "State-cell names are not listed here; the report is checked against the code with npm run adapter-report."
  ]
}
